<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-ios</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>EvergineMauiMetal</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationTitle>SkiaSharp + Evergine Metal Interop</ApplicationTitle>
    <ApplicationId>com.mattleibow.skiasharp.evergine.metal</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">iossimulator-arm64</RuntimeIdentifier>
    <MtouchInterpreter>-all</MtouchInterpreter>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#0B1020" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0B1020" BaseSize="128,128" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Evergine.Common" />
    <PackageReference Include="Evergine.Components" />
    <PackageReference Include="Evergine.Framework" />
    <PackageReference Include="Evergine.iOS" />
    <PackageReference Include="Evergine.Mathematics" />
    <PackageReference Include="Evergine.Metal" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.iOS" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Interop\**\*.cs" />
    <ProjectReference Include="Interop\EvergineMauiMetal.Interop.csproj" />
  </ItemGroup>
</Project>
